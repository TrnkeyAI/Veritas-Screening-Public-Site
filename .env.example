# GlitchTip (self-hosted, Sentry-protocol-compatible) — baked into the
# static export at build time (see scripts/ship-static.sh). This is a
# static site with no server, so these are the only env vars it uses.
#
# Real values live in the gitignored .env.ship, read by
# scripts/ship-static.sh. Never commit a real DSN.
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_ME@glitchtip.trnkeyai.com/PROJECT_ID
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Set to 1 to fire one captureMessage + one manual span on load, to prove
# the pipe works end to end. Leave unset for normal deploys.
NEXT_PUBLIC_SENTRY_SMOKE=
